# Copy to backend/.env (gitignored) and fill in. Never commit the real file.
# Dev database on the homelab (CT 104); password is FITSCAPE_DEV_PASSWORD from infra/.env there.
DATABASE_URL=postgresql+psycopg://fitscape_dev:change-me@192.168.68.15:5432/fitscape_dev
# Tests wipe tables, so this must point at a database whose name contains "test".
TEST_DATABASE_URL=postgresql+psycopg://fitscape_test:change-me@192.168.68.15:5432/fitscape_test
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PIN_PEPPER=change-me-to-64-hex-characters-change-me-to-64-hex-characters-xx
# Local dev is plain http, so the cookie can't be Secure. Leave unset (true) anywhere HTTPS.
COOKIE_SECURE=false
