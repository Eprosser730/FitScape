# Copy to .env on the homelab (never commit .env), then: chmod 600 .env
# Generate each password with:  openssl rand -hex 24
# (hex, not base64: base64 can contain / and +, which break database connection URLs)
POSTGRES_PASSWORD=change-me
FITSCAPE_DEV_PASSWORD=change-me
FITSCAPE_TEST_PASSWORD=change-me
FITSCAPE_PROD_PASSWORD=change-me
FITSCAPE_READONLY_PASSWORD=change-me
